# ── Codeck — local-first configuration ───────────────────────────────────────
# Default posture: everything runs on this machine. No transcript, no audio and
# no client data reaches a third party.

# Local inference only. Setting anything else requires OFFLINE_MODE=0, and the
# server refuses to boot otherwise.
AI_PROVIDER=local

# 1 (default) = refuse cloud providers, refuse to start if a cloud API key is
# set, and block every non-localhost request from the UI.
OFFLINE_MODE=1

# ── Local models (Ollama) ────────────────────────────────────────────────────
# Install:  brew install ollama && ollama serve
# Pull:     ollama pull qwen2.5:3b-instruct && ollama pull nomic-embed-text
OLLAMA_HOST=http://127.0.0.1:11434
LOCAL_MODEL=qwen2.5:3b-instruct
EMBED_MODEL=nomic-embed-text

# Optional: a larger model for when quality matters more than speed.
# Only set this if you have the RAM free — Ollama reports what is available.
# LOCAL_QUALITY_MODEL=qwen2.5:7b-instruct

# Context budgets, in tokens. These are tuned for SPEED, not for the model's
# context limit: on CPU-only inference prefill dominates, so a smaller prompt is
# the cheapest win available.
CTX_BUDGET_GENERATE=1500
CTX_BUDGET_EDIT=600

# Raise if generation times out on slower hardware.
LOCAL_TIMEOUT_MS=600000
LOCAL_NUM_CTX=8192

# ── Local transcription (whisper.cpp) ────────────────────────────────────────
# brew install whisper-cpp ffmpeg
# mkdir -p ~/.codeck/models && curl -L -o ~/.codeck/models/ggml-small.en.bin \
#   https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-small.en.bin
# small.en-q5_1 is the quantised build: ~2.5x faster than small.en for the same
# transcript quality. Download it with:
#   curl -L -o ~/.codeck/models/ggml-small.en-q5_1.bin \
#     https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-small.en-q5_1.bin
# Leave WHISPER_MODEL unset to use it automatically whenever it is installed.
# WHISPER_MODEL=small.en
# WHISPER_BIN=whisper-cli
# WHISPER_MODEL_PATH=/absolute/path/to/ggml-small.en.bin
#
# Transcription runs through whisper-server, which loads the model once and
# stays resident. whisper-cli reloads ~470 MB on every call — about 10 seconds
# of fixed cost per segment — which is far too slow to keep up with a meeting.
# Set WHISPER_SERVER=0 to force the old one-process-per-segment path.
# WHISPER_SERVER=0
# WHISPER_PORT=8917
# Threads default to physical cores. Hyperthreads measured SLOWER here:
# a 15s clip took 23s at -t 4 and 33s at -t 8.
# WHISPER_THREADS=4
#
# base.en is roughly 3x faster again and noticeably less accurate — worth trying
# only if the quantised small.en still cannot keep pace.
#
# WHISPER_WINDOW_S sizes the encoder context (the biggest single speedup: a 15s
# clip went 35.6s -> 17.5s). Audio LONGER than this window does not just get
# clipped, it degenerates into repetition, so the recorder's segment length in
# electron/renderer/app.js must stay inside it. Change both together.
# WHISPER_WINDOW_S=14

# ── App ──────────────────────────────────────────────────────────────────────
PORT=3001
DATA_DIR=/Users/YOUR_USERNAME/.codeck

# ── Cloud providers — only usable with OFFLINE_MODE=0 ───────────────────────
# Enabling any of these sends your meeting transcript to a third party.
# GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
